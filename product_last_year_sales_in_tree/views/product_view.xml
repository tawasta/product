<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
	<record id="product_product_tree_view" model="ir.ui.view">
		<field name="name">product.product.tree.last.year.sales</field>
		<field name="model">product.product</field>
		<field name="inherit_id" ref="product.product_product_tree_view" />
		<field name="arch" type="xml">
            <field name="lst_price" position="before">
                <field string="12 month sales" name="sales_count" optional="show" />
		    </field>
		</field>
	</record>

    <record id="product_template_tree_view" model="ir.ui.view">
		<field name="name">product.template.tree.last.year.sales</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_tree_view" />
		<field name="arch" type="xml">
            <field name="list_price" position="before">
                <field string="12 month sales" name="sales_count" optional="show" />
		    </field>
		</field>
	</record>
</odoo>
