<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form.inherit.number.of.users</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">

            <field name="additional_product_tag_ids" position="after">
                <label for="number_of_users_min" string="Number of Users" />
                <div>
                    <field
                        name="number_of_users_min"
                        class="oe_inline"
                        style="vertical-align:baseline"
                    /> -
                    <field
                        name="number_of_users_max"
                        class="oe_inline"
                        style="vertical-align:baseline"
                    />
                </div>
            </field>
        </field>
    </record>
</odoo>
