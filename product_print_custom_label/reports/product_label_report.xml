<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="report_custom_a4">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-set="copies" t-value="pallet_amount" />
                <t t-foreach="range(copies)" t-as="copy">
                    <div class="page" style="page-break-after: always;">
                        <div
                            style="width:100%; height:100%; display:flex; flex-direction:column; justify-content:center; align-items:center; font-family: Arial, sans-serif; padding: 15mm;"
                        >

                            <!-- Product Code -->
                            <div style="margin-bottom: 2mm; text-align: center;">
                                <div
                                    style="font-size: 100pt; font-weight: bold; margin-top: 3mm;"
                                    t-field="doc.default_code"
                                />
                            </div>
                            <!-- Quantity -->
                            <div
                                style="margin-bottom: 2mm; text-align: center; white-space: nowrap;"
                            >
                                <span
                                    style="font-size: 100pt; font-weight: bold; margin-top: 3mm;"
                                    t-esc="display_quantity"
                                />
                                <span
                                    style="font-size: 40pt; font-weight: bold; margin-left: 5mm;"
                                >pcs</span>
                            </div>
                            <!-- Product Name -->
                            <div style="margin-bottom: 4mm; text-align: center;">
                                <div
                                    style="font-size: 18pt; font-weight: bold; margin-top: 3mm;"
                                    t-field="doc.name"
                                />
                            </div>
                            <!-- Barcode -->
                            <div style="margin-bottom: 4mm; text-align: center;">
                                <t t-if="doc.barcode">
                                    <div
                                        t-out="doc.barcode"
                                        t-options="{'widget': 'barcode', 'symbology': 'auto', 'img_style': barcode_img_style}"
                                    />
                                    <div
                                        style="font-size: 14pt; font-family: monospace; margin-top: 4mm; letter-spacing: 3px;"
                                        t-esc="doc.barcode"
                                    />
                                </t>
                                <t t-else="">
                                    <div
                                        style="font-size: 20pt; color: #999; font-weight: 600;"
                                    >No barcode</div>
                                </t>
                            </div>
                            <!-- Default Location (shortened) -->
                            <div style="margin-bottom: 4mm; text-align: center;">
                                <div
                                    style="font-size: 10pt; color: #555; text-transform: uppercase; letter-spacing: 2px; font-weight: 600;"
                                >Default Location</div>
                                <t
                                    t-set="loc_name"
                                    t-value="doc.default_stock_move_location_id.display_name or ''"
                                />
                                <div
                                    style="font-size: 16pt; font-weight: bold; margin-top: 2mm;"
                                    t-esc="loc_name and loc_name.rsplit('/', 1)[-1] or ''"
                                />
                            </div>
                            <!-- Date -->
                            <div style="text-align: center;">
                                <div
                                    style="font-size: 10pt; color: #555; text-transform: uppercase; letter-spacing: 2px; font-weight: 600;"
                                >Date</div>
                                <div
                                    style="font-size: 16pt; font-weight: bold; margin-top: 2mm;"
                                    t-esc="today.strftime('%d.%m.%Y')"
                                />
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="paperformat_product_template_custom_a4" model="report.paperformat">
        <field name="name">A4 Landscape - Product Custom Label</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="disable_shrinking" eval="True" />
        <field name="dpi">96</field>
    </record>

    <record id="report_product_template_custom_a4" model="ir.actions.report">
        <field name="name">A4 Custom Label</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">product_print_custom_label.report_custom_a4</field>
        <field name="report_file">product_print_custom_label.report_custom_a4</field>
        <field
            name="paperformat_id"
            ref="product_print_custom_label.paperformat_product_template_custom_a4"
        />
        <field
            name="print_report_name"
        >'Custom Labels - %s' % (object.name or '')</field>
        <field name="binding_model_id" eval="False" />
        <field name="binding_type">report</field>
    </record>

</odoo>
