<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//tree//field[@name='name']"
                position="after"
            >
                <field name="version_code_info" class="version_class" />
            </xpath>

            <xpath
                expr="//field[@name='order_line']//tree//field[@name='product_template_id']"
                position="attributes"
            >
                <attribute name="class" separator=" " add="listen_product" />
            </xpath>

            <xpath
                expr="//field[@name='order_line']//tree//field[@name='product_id']"
                position="attributes"
            >
                <attribute name="class" separator=" " add="listen_product" />
            </xpath>
        </field>
    </record>
</odoo>
