<?xml version="1.0" encoding="UTF-8"?>

<odoo>
	<record id="product_template_form_view" model="ir.ui.view">
		<field name="name">product.template.form.code.version</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_form_view" />
		<field name="arch" type="xml">
            <button name="action_open_documents" position="after">
<!--                 <button class="oe_stat_button" name="action_open_version_codes" type="object" icon="fa-file-text-o"> -->
                <button class="oe_stat_button" name="action_open_version_codes" type="object" icon="fa-layer-group-text-o">
                    <field string="Product version codes" name="version_code_count" widget="statinfo"/>
                </button>
		    </button>
		</field>
	</record>
</odoo>
