<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.product.material.compliance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='warehouse_setting_container']" position="after">
                <block
                    title="Product Material Compliance Types"
                    name="product_materials_compliance_settings"
                >
                    <setting
                        id="group_prod_mat_comp_manage_compliance_chemicals"
                        help="Check box to show 'Chemicals' status selection field on product page's Materials tab's lines."
                    >
                        <field name="group_prod_mat_comp_manage_compliance_chemicals" />
                    </setting>

                    <setting
                        id="group_prod_mat_comp_manage_compliance_conflict_area_minerals"
                        help="Check box to show 'Conflict Area Minerals' status selection field on product page's Materials tab's lines."
                    >
                        <field
                            name="group_prod_mat_comp_manage_compliance_conflict_area_minerals"
                        />
                    </setting>

                    <setting
                        id="group_prod_mat_comp_manage_compliance_halogens"
                        help="Check box to show 'Halogens' status selection field on product page's Materials tab's lines."
                    >
                        <field name="group_prod_mat_comp_manage_compliance_halogens" />
                    </setting>

                    <setting
                        id="group_prod_mat_comp_manage_compliance_pop"
                        help="Check box to show 'POP' (Persistent Organic Pollutants) status selection field on product page's Materials tab's lines."
                    >
                        <field name="group_prod_mat_comp_manage_compliance_pop" />
                    </setting>

                    <setting
                        id="group_prod_mat_comp_manage_compliance_reach"
                        help="Check box to show 'REACH' status selection field on product page's Materials tab's lines."
                    >
                        <field name="group_prod_mat_comp_manage_compliance_reach" />
                    </setting>

                    <setting
                        id="group_prod_mat_comp_manage_compliance_rohs"
                        help="Check box to show 'RoHS' status selection field on product page's Materials tab's lines."
                    >
                        <field name="group_prod_mat_comp_manage_compliance_rohs" />
                    </setting>

                    <setting
                        id="group_prod_mat_comp_manage_compliance_scip"
                        help="Check box to show 'SCIP' (Substances of Concern in Products) status selection field on product page's Materials tab's lines."
                    >
                        <field name="group_prod_mat_comp_manage_compliance_scip" />
                    </setting>

                    <!-- Add a link to the menu where the yes/no etc. allowed values are managed -->
                    <div
                        class="col-12 col-lg-6 o_setting_box"
                        id="product_compliance_values_link_box"
                    >
                        <button
                            name="product_compliant.action_product_compliant_values"
                            icon="fa-arrow-right"
                            type="action"
                            string="Manage Compliance Values"
                            class="btn-link o_web_settings_access_rights"
                        />
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
