<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_designer_commission" model="ir.ui.view">
        <field name="name">product.template.form.inherit.designer.commission</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='categ_id']" position="after">
                <field
                    name="designer_id"
                    options="{'no_create': False, 'no_open': False}"
                />
            </xpath>

        </field>
    </record>

    <record id="product_template_search_view_inherit_designer_commission" model="ir.ui.view">
        <field name="name">product.template.search.inherit.designer.commission</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">
                <field name="designer_id"/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter
                    name="group_by_designer"
                    string="Designer"
                    context="{'group_by': 'designer_id'}"
                />
            </xpath>

        </field>
    </record>

</odoo>