<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_sale_invoice_exclusion_rule_form" model="ir.ui.view">
        <field name="name">product.sale.invoice.exclusion.rule.form</field>
        <field name="model">product.sale.invoice.exclusion.rule</field>
        <field name="arch" type="xml">
            <form string="Sale Invoice Exclusion Rule">
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="detailed_type" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field
                                name="tax_ids"
                                widget="many2many_tags"
                                options="{ 'no_create': True, 'no_create_edit': True }"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="product_sale_invoice_exclusion_rule_tree" model="ir.ui.view">
        <field name="name">product.sale.invoice.exclusion.rule.tree</field>
        <field name="model">product.sale.invoice.exclusion.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" optional="hide" />
                <field name="detailed_type" />
                <field name="tax_ids" widget="many2many_tags" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record
        id="product_sale_invoice_exclusion_rule_action"
        model="ir.actions.act_window"
    >
        <field name="name">Sale Invoice Exclusion Rules</field>
        <field name="res_model">product.sale.invoice.exclusion.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first exclusion rule
            </p>
            <p>
                Define combinations of product type and customer taxes.
                Products matching a rule will automatically have
                "Exclude from Sale Invoice" checked.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_product_sale_invoice_exclusion_rule"
        name="Sale Invoice Exclusion Rules"
        parent="account.menu_finance_configuration"
        action="product_sale_invoice_exclusion_rule_action"
        sequence="90"
    />

</odoo>
