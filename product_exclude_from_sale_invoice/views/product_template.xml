<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field
            name="name"
        >product.template.form.inherit.exclude.from.sale.invoice</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <group name="sale" position="inside">
                <group
                    string="Exclude from Invoice"
                    name="group_exclude_from_sale_invoice"
                    col="2"
                >
                    <field
                        name="exclude_from_sale_invoice"
                        widget="boolean_toggle"
                        colspan="2"
                    />
                    <div class="text-muted fst-italic" colspan="2">
                        Invoicing exclusions are managed by rules

                            <a
                            href="#"
                            class="oe_link"
                            type="action"
                            name="%(product_exclude_from_sale_invoice.product_sale_invoice_exclusion_rule_action)d"
                        >
                            ⇒ Manage Rules
                        </a>.
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
