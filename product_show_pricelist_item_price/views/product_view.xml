<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="list_price" position="after">
                <field name="pricelist_price" optional="show" />
            </field>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='pricing']" position="after">
                <label for="pricelist_price" />
                <div name="pricing_pricelist_price" class="o_row">
                  <field
                        name="pricelist_price"
                        class="oe_inline"
                        widget="monetary"
                        options="{'currency_field': 'currency_id', 'field_digits': True}"
                    />
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_template_kanban_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='product_lst_price']" position="after">
                <div name="pricelist_price" class="mt-1">
                    Pricelist Price: <field
                        name="pricelist_price"
                        widget="monetary"
                        options="{'currency_field': 'currency_id', 'field_digits': True}"
                    />
                </div>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view" />
        <field name="arch" type="xml">
            <field name="lst_price" position="after">
                <field name="pricelist_price" optional="show" />
            </field>
        </field>
    </record>

    <record id="product_kanban_view" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_kanban_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='product_lst_price']" position="after">
                <div name="product_lst_price" class="mt-1">
                    Pricelist Price: <field name="pricelist_price" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
