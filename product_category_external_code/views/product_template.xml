<odoo>
    <record id="view_product_form_inherit_category_field" model="ir.ui.view">
        <field name="name">product.template.form.category.field</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='general_information']//field[@name='categ_id']"
                position="after"
            >
                <field name="external_code" />
            </xpath>
        </field>
    </record>

    <record id="view_product_tree_inherit_category_field" model="ir.ui.view">
        <field name="name">product.template.tree.category.field</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="external_code" />
            </xpath>
        </field>
    </record>
</odoo>
