<odoo>
    <record id="product_template_form_inherit_state" model="ir.ui.view">
        <field name="name">product.template.form.state.fix</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='general_information']//field[@name='categ_id']"
                position="after"
            >
                <field name="product_state_id" string="Product Status" />
            </xpath>
        </field>
    </record>
    <record id="product_template_tree_replace_state" model="ir.ui.view">
        <field name="name">product.template.tree.replace.state</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="product_state.product_template_view_tree_inherit_product_state_id"
        />

        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="product_state_id" string="Product Status" />
            </field>
        </field>
    </record>
    <record id="product_template_tree_hide_state" model="ir.ui.view">
        <field name="name">product.template.tree.hide.state</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="priority">60</field>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
